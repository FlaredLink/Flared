{
	"name": "flared-core",
	"private": true,
	"license": "AGPL-3.0-only",
	"type": "module",
	"packageManager": "bun@1.3.14",
	"scripts": {
		"test:auth-probe": "vitest run --config tests/vitest.config.ts tests/auth-proof-probe.test.ts",
		"check": "tsc --noEmit && svelte-check --workspace packages/ui --tsconfig ./tsconfig.json --fail-on-warnings",
		"format:check": "prettier --check package.json tsconfig.json .prettierrc.json packages tests",
		"test": "vitest run --config tests/vitest.config.ts",
		"test:cli": "vitest run --config packages/cli/vitest.config.ts",
		"build:cli": "bun run --cwd packages/cli build && bun run --cwd packages/cli smoke"
	},
	"dependencies": {
		"better-auth": "1.7.6",
		"@better-auth/drizzle-adapter": "1.7.6",
		"drizzle-orm": "0.45.3"
	},
	"devDependencies": {
		"@cfworker/json-schema": "4.1.1",
		"@cloudflare/vitest-pool-workers": "0.22.0",
		"@cloudflare/workers-types": "5.20260930.2",
		"@types/node": "24.10.1",
		"@vitest/runner": "4.1.11",
		"@vitest/snapshot": "4.1.11",
		"prettier": "3.9.9",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3",
		"vitest": "4.1.11",
		"wrangler": "4.143.1"
	},
	"workspaces": [
		"packages/*"
	]
}
