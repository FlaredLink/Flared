{
	"name": "@flaredlink/cli",
	"version": "0.2.0",
	"description": "Create, edit, and measure Flared short links from your terminal.",
	"license": "AGPL-3.0-only",
	"type": "module",
	"homepage": "https://flared.page/docs#cli",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/FlaredLink/Flared.git",
		"directory": "packages/cli"
	},
	"bin": {
		"flared": "dist/flared.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE.md"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "bun build src/main.ts --target=node --outfile dist/flared.js && cp ../../LICENSE.md LICENSE.md",
		"smoke": "node dist/flared.js --version && node dist/flared.js --help"
	},
	"devDependencies": {
		"@flared/client": "workspace:*",
		"@flared/contracts": "workspace:*"
	}
}
